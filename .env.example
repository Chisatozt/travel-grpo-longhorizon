# Qwen actor used for SFT and GRPO. It is never used as a UserBench simulator.
BASE_MODEL=Qwen/Qwen3.5-2B
GRPO_ACTOR_MODEL=Qwen/Qwen3.5-2B
ACTOR_BASE_URL=http://127.0.0.1:8000/v1
ACTOR_API_KEY=EMPTY
ACTOR_MODEL=Qwen/Qwen3.5-2B
ACTOR_TEMPERATURE=0
ACTOR_MAX_TOKENS=4096
ACTOR_TIMEOUT=120

# External teacher used only to collect SFT trajectories.
TEACHER_BASE_URL=https://your-deepseek-compatible-provider.example/v1
TEACHER_API_KEY=
TEACHER_MODEL=deepseek-v4-flash
TEACHER_THINKING=disabled
TEACHER_TEMPERATURE=0
TEACHER_MAX_TOKENS=4096
TEACHER_TIMEOUT=60
TEACHER_MAX_RETRIES=2
TEACHER_PROTOCOL_RETRIES=2
TEACHER_ACTION_RETRIES=2
TEACHER_THOUGHT_MAX_CHARS=200

# UserBench simulator used while the teacher collects trajectories. These
# variables stay separate even when they point to the same provider account.
COLLECTION_USER_SIM_BACKEND=openai_compatible
COLLECTION_USER_SIM_BASE_URL=https://your-deepseek-compatible-provider.example/v1
COLLECTION_USER_SIM_API_KEY=
COLLECTION_USER_SIM_MODEL=deepseek-v4-flash
COLLECTION_USER_SIM_TEMPERATURE=0
COLLECTION_USER_SIM_MAX_TOKENS=2048
COLLECTION_USER_SIM_TIMEOUT=60

# UserBench simulator inside the veRL GRPO worker process.
GRPO_USER_SIM_BACKEND=openai_compatible
GRPO_USER_SIM_BASE_URL=https://your-deepseek-compatible-provider.example/v1
GRPO_USER_SIM_API_KEY=
GRPO_USER_SIM_MODEL=deepseek-v4-flash
GRPO_USER_SIM_TEMPERATURE=0
GRPO_USER_SIM_MAX_TOKENS=2048
GRPO_USER_SIM_TIMEOUT=60

# Evaluation-time user simulator. Pin the provider model before formal evaluation.
EVAL_USER_SIM_BACKEND=openai_compatible
EVAL_USER_SIM_BASE_URL=https://your-deepseek-compatible-provider.example/v1
EVAL_USER_SIM_API_KEY=
EVAL_USER_SIM_MODEL=deepseek-v4-flash
EVAL_USER_SIM_TEMPERATURE=0
EVAL_USER_SIM_MAX_TOKENS=2048
EVAL_USER_SIM_TIMEOUT=60
