# Actor model served through an OpenAI-compatible endpoint.
BASE_MODEL=Qwen/Qwen3.5-2B
ACTOR_BASE_URL=http://127.0.0.1:8000/v1
ACTOR_API_KEY=EMPTY
SERVED_MODEL_NAME=travel-agent

# Training-time user simulator. Keep this isolated from the actor endpoint.
TRAIN_USER_SIM_BACKEND=openai_compatible
TRAIN_USER_SIM_BASE_URL=http://127.0.0.1:8001/v1
TRAIN_USER_SIM_API_KEY=EMPTY
TRAIN_USER_SIM_MODEL=

# Evaluation-time user simulator. Pin the provider model before formal evaluation.
EVAL_USER_SIM_BACKEND=openai
EVAL_USER_SIM_BASE_URL=https://api.openai.com/v1
EVAL_USER_SIM_API_KEY=
EVAL_USER_SIM_MODEL=
